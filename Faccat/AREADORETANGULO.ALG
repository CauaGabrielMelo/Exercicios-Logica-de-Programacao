Algoritmo "AreadoRetangulo"
// Disciplina   : [Lógica de Programação com JavaScipt]
// Professor   : Jailson Costa dos Santos
// Descrição   : Escreva um algoritmo para ler as dimensões de um retângulo
//(base e altura), calcular e escrever a área do retângulo.
// Autor(a)    : Cauã Gabriel Araujo de Melo
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
Base: Real
Altura: Real
Area: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
Escreval ("Área do retângulo")
Escreval ("Digite o valor da base: ")
Leia (Base)
Escreval ("Digite o valor da altura")
Leia (Altura)
Area <-Base * Altura
Escreval ("O valor da Área é: ", Area)

Fimalgoritmo